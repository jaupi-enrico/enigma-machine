<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="590.0" prefWidth="620.0" spacing="20.0" style="-fx-background-color: #2b2b2b; -fx-border-color: #4E382B; -fx-border-width: 10;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.enigma.enigmamachine.EnigmaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox alignment="CENTER" onKeyPressed="#onKeyPressed" prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="nextRotore1" onMouseClicked="#nextPosRotore1" text="Label" />
                  <Label fx:id="attualeRotore1" text="Label" />
                  <Label fx:id="previousRotore1" onMouseClicked="#previousPosRotore1" text="Label" />
               </children></VBox>
            <VBox layoutX="10.0" layoutY="10.0" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="nextRotore2" onMouseClicked="#nextPosRotore2" text="Label" />
                  <Label fx:id="attualeRotore2" text="Label" />
                  <Label fx:id="previousRotore2" onMouseClicked="#previousPosRotore2" text="Label" />
               </children>
            </VBox>
            <VBox layoutX="110.0" layoutY="10.0" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="nextRotore3" onMouseClicked="#nextPosRotore3" text="Label" />
                  <Label fx:id="attualeRotore3" text="Label" />
                  <Label fx:id="previousRotore3" onMouseClicked="#previousPosRotore3" text="Label" />
               </children>
            </VBox>
         </children>
      </HBox>
      <GridPane fx:id="gridLight" alignment="CENTER" hgap="10.0" onKeyPressed="#onKeyPressed" vgap="10.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" />
          <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="SOMETIMES" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints vgrow="SOMETIMES" />
          <RowConstraints vgrow="SOMETIMES" />
          <RowConstraints vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>
      <GridPane fx:id="gridButton" alignment="CENTER" cache="true" hgap="10.0" onKeyPressed="#onKeyPressed" vgap="10.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" />
          <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="SOMETIMES" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints vgrow="SOMETIMES" />
          <RowConstraints vgrow="SOMETIMES" />
          <RowConstraints vgrow="SOMETIMES" />
        </rowConstraints>
         <VBox.margin>
            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </GridPane>
      <GridPane fx:id="gridPlugBoard" alignment="CENTER" hgap="10.0" onKeyPressed="#onKeyPressed" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>
      <HBox alignment="CENTER" onKeyPressed="#onKeyPressed" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
         <children>
            <TextArea fx:id="inputTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
            <TextArea fx:id="outputTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
         </children>
      </HBox>
      <Button mnemonicParsing="false" text="Button" />
   </children>
</VBox>
