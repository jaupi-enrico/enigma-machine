<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="590.0" prefWidth="620.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.enigma.enigmamachine.EnigmaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox onKeyPressed="#onKeyPressed" prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="nextRotore1" onMouseClicked="#nextPosRotore1" text="Label" />
                  <Label fx:id="attualeRotore1" text="Label" />
                  <Label fx:id="previousRotore1" onMouseClicked="#previousPosRotore1" text="Label" />
               </children></VBox>
            <VBox layoutX="10.0" layoutY="10.0" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="nextRotore2" onMouseClicked="#nextPosRotore2" text="Label" />
                  <Label fx:id="attualeRotore2" text="Label" />
                  <Label fx:id="previousRotore2" onMouseClicked="#previousPosRotore2" text="Label" />
               </children>
            </VBox>
            <VBox layoutX="110.0" layoutY="10.0" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="nextRotore3" onMouseClicked="#nextPosRotore3" text="Label" />
                  <Label fx:id="attualeRotore3" text="Label" />
                  <Label fx:id="previousRotore3" onMouseClicked="#previousPosRotore3" text="Label" />
               </children>
            </VBox>
         </children>
      </HBox>
      <GridPane fx:id="gridLight" onKeyPressed="#onKeyPressed">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>
      <GridPane fx:id="gridButton" onKeyPressed="#onKeyPressed">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>
      <GridPane fx:id="gridPlugBoard" onKeyPressed="#onKeyPressed">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>
      <HBox onKeyPressed="#onKeyPressed" prefHeight="100.0" prefWidth="200.0">
         <children>
            <TextArea fx:id="inputTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
            <TextArea fx:id="outputTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
         </children>
      </HBox>
   </children>
</VBox>
